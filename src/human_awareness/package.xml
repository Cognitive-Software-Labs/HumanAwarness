<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>human_awareness</name>
  <version>0.0.1</version>
  <description>
    Per-person awareness over time ("knows the robot is there"), accumulated
    per track_id from human_gaze's sees_robot decisions: the first dimension
    of the per-ID aggregation stage.
  </description>
  <maintainer email="lauramuresan420@gmail.com">Laura</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>human_awareness_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
